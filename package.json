{
  "name": "ust-qpass",
  "version": "1.0.0",
  "description": "UST QPass - Digital Event Token System",
  "scripts": {
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "seed": "cd server && npm run seed",
    "build": "cd client && npm install --include=dev && npm run build && cd ../server && npm install",
    "start": "cd server && node src/index.js",
    "install:all": "cd server && npm install && cd ../client && npm install",
    "test": "cd server && npm test && cd ../client && npm test",
    "test:server": "cd server && npm test",
    "test:client": "cd client && npm test",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:report": "npx playwright show-report e2e/reports/html",
    "test:e2e:excel": "node e2e/generate-report.js",
    "test:e2e:full": "npx playwright test && node e2e/generate-report.js",
    "test:e2e:auth": "npx playwright test 01-auth",
    "test:e2e:events": "npx playwright test 02-events",
    "test:e2e:booking": "npx playwright test 03-booking",
    "test:e2e:scanning": "npx playwright test 04-scanning",
    "test:e2e:walkin": "npx playwright test 05-walkin",
    "test:e2e:admin": "npx playwright test 06-admin",
    "test:e2e:roles": "npx playwright test 07-role",
    "test:e2e:security": "npx playwright test 08-security",
    "test:e2e:journeys": "npx playwright test 09-e2e",
    "loadtest": "node loadtest/load-test.js",
    "loadtest:register": "node loadtest/load-test.js register 100 1000",
    "loadtest:scan": "node loadtest/load-test.js scan 100 1000",
    "loadtest:mixed": "node loadtest/load-test.js mixed 100 1000",
    "loadtest:artillery:register": "npx artillery run loadtest/artillery-registration.yml",
    "loadtest:artillery:scan": "npx artillery run loadtest/artillery-scanning.yml",
    "start:cluster": "pm2-runtime ecosystem.config.js",
    "start:pm2": "pm2 start ecosystem.config.js",
    "stop:pm2": "pm2 delete all",
    "status:pm2": "pm2 status",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:scale": "docker compose up -d --build --scale api-1=1 --scale api-2=1 --scale api-3=1"
  },
  "devDependencies": {
    "artillery": "^2.0.33",
    "concurrently": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "pm2": "^7.0.3"
  }
}
